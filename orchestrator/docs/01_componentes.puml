@startuml Componentes_Orquestador_Colbun_v2

title Diagrama de Componentes v2 — Orquestador de Ejecución Operacional\nColbun S.A. | Arquitectura basada en máquina de estados

skinparam componentStyle uml2
skinparam backgroundColor #FEFEFE
skinparam component { BackgroundColor #E8F4FD; BorderColor #1A5276; FontColor #2C3E50 }
skinparam database { BackgroundColor #FEF9E7; BorderColor #F39C12 }
skinparam node { BackgroundColor #EAFAF1; BorderColor #27AE60 }
skinparam package { BorderColor #1A5276; FontColor #1A5276; FontStyle Bold }

' ── Actores ──────────────────────────────────────────────────
actor "Operador de Turno /\nJefe de Turno" as OP
actor "Jefe de Turno /\nIngeniero de Turno" as ING
actor "Jefe de Turno /\nOperador COC" as COC
actor "Despachador CDC /\nOperador COC" as CDC

' ── Frontend HMI (interfaz de ejecución — NO controla el flujo) ──
package "Frontend (HMI)" as HMI #F0F7FB {
    component [task.html\n---\nEjecuta la tarea del actor\n- Checklist + inputs + validación\n- Botón COMPLETAR (→ POST /complete)\n- Botón STOP si allow_stop=true (→ POST /stop)\n- Decisiones: opciones visibles para nodos type=decision] as TASK

    component [process.html\n---\nVisualiza el flujo\n- Timeline con history_log\n- node_state por nodo\n- Estado actual del proceso] as PROC

    note bottom of HMI
        El HMI es solo una interfaz de ejecución.
        No decide el flujo. Solo llama a la API.
    end note
}

' ── API Flask (capa delgada) ──────────────────────────────────
package "API (Flask)" as API #F5EFF7 {
    component [POST /trigger\n---\nInicia instancia vía InstanceManager\nLuego NotificationDispatcher activa T1] as A_TRIG
    component [POST /complete\n---\nDelega a StateEngine.execute_transition()\nRecibe: instance_id, node_id, inputs, decision] as A_COMP
    component [POST /stop\n---\nDelega a StateEngine.stop_process()\nRequiere: motivo + allow_stop=true en nodo] as A_STOP
    component [POST /block  POST /unblock\n---\nDelega a StateEngine.block/unblock_process()] as A_BLOCK
    component [GET /instance  GET /inbox\n---\nConsultas directas a DB\nNo pasa por CORE] as A_QUERY
}

' ── CORE: El núcleo del orquestador ──────────────────────────
package "Orquestador (CORE)" as CORE #FFF8E8 {

    component [InstanceManager\n---\ncreate_process():\n  1. Valida PROCEDURES config\n  2. create_instance() en DB\n  3. create_node_state(T1, IN_PROGRESS)\nget_process() / list_active()] as IM

    component [StateEngine\n---\nexecute_transition():\n  1. Valida estado == EN_CURSO\n  2. Valida current_node == node_id\n  3. Guarda inputs en process_instances\n  4. Delega append → history_log\n  5. update_node_state → COMPLETED\n  6. Delega → TransitionLogic\n  7. update_instance(current_node)\n  8. create_node_state(next, IN_PROGRESS)\n  9. Delega → NotificationDispatcher\nstop_process() / block_process() / unblock_process()] as SE

    component [TransitionLogic\n---\nLógica pura — SIN acceso a DB\nresolve_next(node, decision):\n  type=task     → node["next"]\n  type=decision → opciones[decision]["next"]\n  type=end      → None (cierre)\nresolve_contacts(rol_string):\n  Parsea "Rol A / Rol B"\n  Match exacto primero, parcial fallback\n  Retorna lista [{nombre, email}]\nis_stop_allowed(node) → bool] as TL

    component [NotificationDispatcher\n---\ndispatch_to_actor():\n  1. resolve_contacts(rol) via TransitionLogic\n  2. create_notification() en DB por contacto\n  3. Si NOTIF_MODE=email → _send_email()\ndispatch_stop_alert():\n  Notifica a TODOS los roles (emergencia)] as ND

    note bottom of CORE
        El CORE es el núcleo real del sistema.
        La API lo llama — nunca implementa lógica de flujo.
        Las notificaciones son el mecanismo de activación,
        no un efecto secundario.
    end note
}

' ── Base de Datos ─────────────────────────────────────────────
package "Base de Datos (SQLite)" as DB #EAFAF1 {
    database "process_instances\n---\nid, pro_id, trigger_event\ncurrent_node\nestado: EN_CURSO|COMPLETADO|\n  BLOQUEADO|RECHAZADO|DETENIDO\ninputs (JSON por nodo)\ncreated_at, updated_at" as TBL_PROC

    database "node_state\n---\nid, instance_id, node_id\nestado: IN_PROGRESS|COMPLETED|\n  STOPPED|BLOCKED\nstarted_at\ncompleted_at (nullable)" as TBL_NS

    database "history_log\n---\nid, instance_id, node_id\ntitulo, rol\ninputs (JSON)\ndecision, decision_label\ncompleted_at (timestamp real)" as TBL_HIST

    database "notifications\n---\nid, instance_id, node_id\nrol, contact_name, contact_email\ntitulo, mensaje\ntipo: TASK|STOP\nestado: PENDIENTE|LEIDA|COMPLETADA\nlink (/task/<iid>/<nid>)\ncreated_at, read_at, acted_at" as TBL_NOTIF
}

' ── Procedimientos JSON ───────────────────────────────────────
database "Procedimientos JSON\n(pro115.json)" as JSON #FEF9E7 {
    component [Nodo task:\n  titulo, rol, descripcion\n  acciones[], checklist[]\n  inputs[] (key, label, required)\n  validacion, allow_stop\n  next → node_id\nNodo decision:\n  pregunta, opciones[]\n  opciones[i].label + .next\n  allow_stop\nNodo end:\n  titulo, mensaje\n  estado_final] as JSON_DEF
}

' ── Canales de notificación ───────────────────────────────────
node "Canales de Notificación" as CHAN {
    component [Inbox UI\n(/inbox/<email>)\n---\nBandeja web simulada\nVis. PENDIENTE/LEIDA/COMPLETADA\nLink directo a /task/<iid>/<nid>] as INBOX_UI
    component [Email (Resend)\n---\nActivo con NOTIF_MODE=email\nResend API (free tier: 100/día)\nPreparado, no activo por defecto] as EMAIL
}

' ── Integraciones externas (futuro) ──────────────────────────
node "Integraciones Externas\n(futuro — mock actual)" as EXT {
    component [SIGO / SAP PM\n(input manual hoy)] as SIGO
    component [SCADA\n(trigger manual hoy)] as SCADA
}

' ── Conexiones ───────────────────────────────────────────────

' Actores → HMI
OP -down-> TASK
OP -down-> PROC
ING -down-> TASK
COC -down-> TASK
CDC -down-> TASK

' HMI → API
TASK -down-> A_COMP : POST /complete
TASK -down-> A_STOP : POST /stop
PROC -down-> A_QUERY : GET /instance
OP --> A_TRIG : POST /trigger (dashboard)

' API → CORE
A_TRIG -down-> IM : create_process()
A_COMP -down-> SE : execute_transition()
A_STOP -down-> SE : stop_process()
A_BLOCK -down-> SE : block/unblock_process()

' CORE internals
IM -right-> SE : (inicia primer nodo)
SE -down-> TL : resolve_next()\nresolve_contacts()
SE -down-> ND : dispatch_to_actor()\ndispatch_stop_alert()
ND -right-> TL : resolve_contacts()

' CORE → DB
IM -down-> TBL_PROC : create_instance()
IM -down-> TBL_NS : create_node_state(T1, IN_PROGRESS)
SE -down-> TBL_PROC : update_instance()
SE -down-> TBL_NS : update_node_state()\ncreate_node_state(next)
SE -down-> TBL_HIST : append_history_log()
SE -down-> TBL_NOTIF : mark_notification(COMPLETADA)
ND -down-> TBL_NOTIF : create_notification()

' CORE → JSON
SE -right-> JSON_DEF : load_procedure()\nnodos[node_id]
TL -right-> JSON_DEF : resolve_next(node)

' Notificaciones → Canales
ND -down-> INBOX_UI : crea registro DB
ND ..> EMAIL : si NOTIF_MODE=email

' Canal → Actor
INBOX_UI -up-> OP : activa actor
INBOX_UI -up-> ING : activa actor
INBOX_UI -up-> COC : activa actor
INBOX_UI -up-> CDC : activa actor

' Consultas directas DB
A_QUERY -down-> TBL_PROC
A_QUERY -down-> TBL_NOTIF

' Futuro
SCADA ..> A_TRIG : evento falla (futuro)
TASK ..> SIGO : input manual (mock)

@enduml
