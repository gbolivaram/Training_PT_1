@startuml Secuencia_PRO115_v2

title Diagrama de Secuencia v2 — PRO115 Aviso de Falla\nOrquestador basado en máquina de estados + activación por notificación

skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam sequence {
    ArrowColor #1A5276
    LifeLineBorderColor #7F8C8D
    ParticipantBackgroundColor #E8F4FD
    ParticipantBorderColor #1A5276
    ActorBorderColor #2C3E50
    GroupBackgroundColor #F8FAFC
    GroupBorderColor #BDC3C7
}

' ── Participantes ordenados por capa ─────────────────────────
actor      "Operador de Turno\n(actor)" as OP #D5F5E3
participant "HMI\n(task.html)" as HMI #EBF5FB
participant "API\n(Flask — thin)" as API #F5EFF7
participant "InstanceManager\n(core/)" as IM #FEF9E7
participant "StateEngine\n(core/)" as SE #FEF9E7
participant "TransitionLogic\n(core/ — sin DB)" as TL #FFF8DC
participant "NotifDispatcher\n(core/)" as ND #FDEDEC
database   "DB\n(SQLite)" as DB #EAFAF1
participant "Inbox UI\n(canal)" as INBOX #F9EBEA
actor      "Actor siguiente\n(rol del nodo next)" as NEXT #D5F5E3

' ══════════════════════════════════════════════════════════════
' FASE 1 — TRIGGER: Inicia el proceso
' ══════════════════════════════════════════════════════════════
group #FFF5F5 "Fase 1 — Trigger: instanciar proceso y activar primer actor"

    OP -> API : POST /trigger\n{pro_id: "PRO115", trigger_event: "Falla S/E Quillota"}
    activate API

    API -> IM : create_process("PRO115", evento)
    activate IM
    IM -> DB : create_instance(pro_id, primer_nodo="T1", estado="EN_CURSO")
    DB --> IM : instance_id (UUID)
    IM -> DB : create_node_state(instance_id, "T1", "IN_PROGRESS")
    deactivate IM

    API -> ND : dispatch_to_actor(instance_id, "PRO115", "T1", nodo_T1)
    activate ND
    ND -> TL : resolve_contacts("Operador de Turno / Jefe de Turno")
    TL --> ND : [{email: operador@…}, {email: jefeturno@…}]
    ND -> DB : create_notification(node_id="T1", contact=operador, estado="PENDIENTE",\nlink="/task/<iid>/T1", tipo="TASK")
    ND -> DB : create_notification(node_id="T1", contact=jefeturno, estado="PENDIENTE")
    deactivate ND

    note over DB, INBOX #FFFACD
        ** La notificación IS la activación **
        El sistema no "espera" al actor — le avisa.
        Sin esta notificación, el actor no sabe que debe actuar.
    end note

    API --> OP : {ok: true, instance_id}
    deactivate API

    ' Canal activa al actor
    INBOX -> OP : Notificación PENDIENTE:\n"[PRO115] 1. Detectar y confirmar la falla"
end

' ══════════════════════════════════════════════════════════════
' FASE 2 — EJECUCIÓN: Actor completa tarea
' ══════════════════════════════════════════════════════════════
group #F0FFF0 "Fase 2 — Ejecución de T1: actor recibe, actúa y completa"

    OP -> HMI : GET /inbox/<email>\n(abre la bandeja)
    HMI -> DB : get_notifications_for_email(email)
    DB --> HMI : [notif T1 PENDIENTE]
    HMI --> OP : Bandeja: notificación T1 con link "/task/<iid>/T1"

    OP -> HMI : Click "Ejecutar Tarea" → POST /notification/<nid>/read
    HMI -> DB : mark_notification(nid, "LEIDA", read_at=now)

    OP -> HMI : GET /task/<iid>/T1
    HMI -> DB : get_instance(iid)
    HMI --> OP : Renderiza task.html:\n- 3 acciones\n- 3 checklist\n- 2 inputs required (hora, instalacion)\n- Validación final

    note over OP #D5F5E3
        Operador ejecuta en terreno:
        ✓ Identifica alarma en SCADA/SIGO
        ✓ Confirma falla visualmente
        ✓ Registra hora de detección
        Luego completa el HMI.
    end note

    OP -> HMI : Marca checklist + llena inputs\n+ click "Completar"
    HMI -> HMI : validateChecklist() → OK\nvalidateInputs() → OK
    HMI -> API : POST /complete\n{instance_id, node_id:"T1",\ninputs:{hora_deteccion:"09:45", instalacion:"S/E Quillota"}}
end

' ══════════════════════════════════════════════════════════════
' FASE 3 — TRANSICIÓN: StateEngine avanza el estado
' ══════════════════════════════════════════════════════════════
group #FFF8E8 "Fase 3 — StateEngine ejecuta la transición"

    activate API
    API -> SE : execute_transition(iid, "T1", inputs)
    activate SE

    SE -> DB : get_instance(iid)
    DB --> SE : {estado:"EN_CURSO", current_node:"T1"} ✓

    note over SE #FFFACD
        Validaciones:
        ① estado == "EN_CURSO" ✓
        ② current_node == "T1" ✓
        Si alguna falla → retorna error, NO avanza
    end note

    SE -> DB : update_instance(inputs["T1"]={hora, instalacion})
    SE -> DB : append_history_log(node_id="T1", titulo, rol,\ninputs, completed_at=NOW_ISO)
    note right of DB #EAFAF1
        history_log — registro auditable:
        - id, instance_id, node_id
        - titulo, rol
        - inputs (JSON)
        - completed_at (timestamp real)
    end note
    SE -> DB : update_node_state("T1", "COMPLETED", completed_at=NOW)
    SE -> DB : mark_notification(notifs de T1 → "COMPLETADA")

    SE -> TL : resolve_next(nodo_T1, decision=None)
    TL --> SE : "T2"
    note over TL : type="task" → node["next"] = "T2"\nSIN acceso a DB

    SE -> DB : update_instance(current_node="T2")
    SE -> DB : create_node_state(iid, "T2", "IN_PROGRESS")

    ' NotificationDispatcher activa siguiente actor
    SE -> ND : dispatch_to_actor(iid, "PRO115", "T2", nodo_T2)
    activate ND
    ND -> TL : resolve_contacts("Operador de Turno / Jefe de Turno")
    TL --> ND : [{operador}, {jefeturno}]
    ND -> DB : create_notification(T2, PENDIENTE)×2
    deactivate ND

    SE --> API : {status:"AVANZADO", node_id:"T2", node:{titulo:...}}
    deactivate SE

    API --> HMI : {status:"AVANZADO", node_id:"T2"}
    deactivate API
    HMI --> OP : "Avanzado a T2. Se notificó al siguiente responsable."

    ' El canal activa al MISMO rol (T2 = mismo actor)
    INBOX -> OP : Nueva notificación PENDIENTE: T2
end

' ══════════════════════════════════════════════════════════════
' FASE 4 — HANDOFF: Cambio de actor en T5
' ══════════════════════════════════════════════════════════════
group #F0F0FF "Fase 4 — Handoff: T4→T5 cambia el actor responsable"

    note over OP, NEXT #FFFACD
        T2, T3, T4 siguen el mismo ciclo (Fase 2+3) con el mismo rol.
        En T5 el rol cambia: "Jefe de Turno / Ingeniero de Turno"
        → NotificationDispatcher activa a un actor diferente.
    end note

    OP -> API : POST /complete {node_id:"T4", inputs:{numero_aviso_sigo:"10045621"}}
    activate API
    API -> SE : execute_transition(iid, "T4", inputs)
    activate SE
    SE -> TL : resolve_next(nodo_T4) → "T5"
    SE -> ND : dispatch_to_actor(iid, "PRO115", "T5", nodo_T5)
    activate ND
    ND -> TL : resolve_contacts("Jefe de Turno / Ingeniero de Turno")
    TL --> ND : [{jefeturno}, {ingeniero}]
    ND -> DB : create_notification(T5, PENDIENTE) × 2
    note right of ND #FFFACD
        ** HANDOFF **
        La notificación activa
        a un actor diferente.
        El Ingeniero de Turno
        ahora es el responsable.
    end note
    deactivate ND
    deactivate SE
    deactivate API

    INBOX -> NEXT : Notificación PENDIENTE:\n"[PRO115] 5. Clasificar tipo y severidad"
    NEXT -> API : POST /complete {node_id:"T5",...}
end

' ══════════════════════════════════════════════════════════════
' FASE 5a — STOP: Detención de emergencia
' ══════════════════════════════════════════════════════════════
group #FDEDEC "Fase 5a — STOP: Detención por condición crítica (T3 o T6)"

    note over OP, HMI
        Si en T3 o T6 (allow_stop=true) hay riesgo crítico,
        el actor presiona el botón STOP en lugar de completar.
    end note

    OP -> HMI : Click "STOP — Condición crítica"\n(prompt: motivo)
    HMI -> API : POST /stop\n{instance_id, node_id:"T3",\nmotivo:"Riesgo eléctrico en área"}
    activate API
    API -> SE : stop_process(iid, "T3", motivo)
    activate SE
    SE -> SE : is_stop_allowed(nodo_T3) → true ✓
    SE -> DB : append_history_log("[STOP] T3", motivo)
    SE -> DB : update_node_state("T3", "STOPPED")
    SE -> DB : update_instance(current_node="END_STOP",\nestado="DETENIDO — REQUIERE INTERVENCIÓN")
    SE -> ND : dispatch_stop_alert(iid, "PRO115", "T3", motivo)
    activate ND
    ND -> DB : create_notification(tipo="STOP") × TODOS los roles
    note right of ND #FDEDEC
        Alerta de STOP a TODOS:
        operador, jefeturno,
        ingeniero, coc, cdc
    end note
    deactivate ND
    deactivate SE
    API --> HMI : {status:"DETENIDO"}
    deactivate API
    HMI --> OP : "PROCESO DETENIDO."
end

' ══════════════════════════════════════════════════════════════
' FASE 5b — DECISIÓN: D_PRUEBA_UNIDAD + D_RESULTADO_PRUEBA
' ══════════════════════════════════════════════════════════════
group #FFF5DC "Fase 5b — Decisiones: D_PRUEBA_UNIDAD y D_RESULTADO_PRUEBA"

    note over NEXT
        CDC/CEN ejecuta D_PRUEBA_UNIDAD
        con 3 opciones reales del JSON
    end note

    NEXT -> HMI : GET /task/<iid>/D_PRUEBA_UNIDAD
    HMI --> NEXT : Renderiza 3 opciones:\n[0] SÍ → T7\n[1] NO → T9\n[2] RECHAZA → END_RECHAZO

    NEXT -> API : POST /complete {node_id:"D_PRUEBA_UNIDAD", decision:0}
    activate API
    API -> SE : execute_transition(iid, "D_PRUEBA_UNIDAD", decision=0)
    activate SE
    SE -> TL : resolve_next(nodo_decision, decision=0)
    TL --> SE : "T7" (opciones[0].next)
    SE -> ND : dispatch_to_actor(T7)
    deactivate SE
    deactivate API

    note over SE, TL
        Si decision=2 → END_RECHAZO (type=end)
        StateEngine detecta type=="end" y cierra el proceso
        sin llamar a NotificationDispatcher.
    end note

    ' T7 completa → D_RESULTADO_PRUEBA (nodo nuevo, antes era T8 con next fijo)
    NEXT -> API : POST /complete {node_id:"T7"}
    API -> SE : execute_transition → "D_RESULTADO_PRUEBA"
    NEXT -> HMI : Renderiza D_RESULTADO_PRUEBA:\n[0] EXITOSA → T9\n[1] FALLIDA sin riesgo → T9\n[2] FALLIDA con riesgo crítico → END_STOP
    NEXT -> API : POST /complete {node_id:"D_RESULTADO_PRUEBA", decision:0}
    API -> SE : execute_transition → "T9"
end

' ══════════════════════════════════════════════════════════════
' FASE 6 — FINALIZACIÓN
' ══════════════════════════════════════════════════════════════
group #D5F5E3 "Fase 6 — Cierre: T9 → END_OK"

    OP -> API : POST /complete {node_id:"T9",\ninputs:{hora_cierre:"11:30", estado_equipo:"Reconectado"}}
    activate API
    API -> SE : execute_transition(iid, "T9", inputs)
    activate SE
    SE -> TL : resolve_next(nodo_T9) → "END_OK"
    SE -> SE : nodos["END_OK"].type == "end" → CERRAR
    SE -> DB : update_instance(\n  current_node="END_OK",\n  estado="COMPLETADO")
    SE -> DB : append_history_log(T9, completed_at)
    SE -> DB : update_node_state("T9", "COMPLETED")
    SE --> API : {status:"FINALIZADO", estado_final:"COMPLETADO"}
    deactivate SE

    note right of DB #D5F5E3
        Estado final en DB:
        process_instances.estado = "COMPLETADO"
        history_log: 9+ entradas con timestamps reales
        node_state: todos los nodos COMPLETED
        notifications: todas COMPLETADA
    end note

    API --> HMI : {status:"FINALIZADO"}
    deactivate API
    HMI --> OP : "Proceso finalizado exitosamente."
end

@enduml
